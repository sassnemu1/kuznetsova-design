# Скопируйте в .env.local (разработка) или .env.production (сервер) и заполните.
RESEND_API_KEY=
CONTACT_EMAIL=info@kuznetsova.design

# Чат-бот. Для Ollama Cloud: host=https://ollama.com + ключ.
# Для локальной Ollama: host=http://127.0.0.1:11434, ключ не нужен.
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b

NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=
